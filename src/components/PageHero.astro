---
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import heroPhoto from '../assets/images/design/hero-truck.jpg';

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	eyebrow?: string;
	title: string;
	lead?: string;
	crumbs?: Crumb[];
	variant?: 'contact';
}

const { eyebrow, title, lead, crumbs = [], variant } = Astro.props;
---

<header class:list={['page-hero', variant && `is-${variant}`]}>
	<Image
		class="page-hero-media"
		src={heroPhoto}
		widths={[768, 1024, 1536, 2048]}
		sizes="100vw"
		format="webp"
		quality={82}
		alt="Goat Garage Door Service garage door repair truck"
		title="Goat Garage Door Service"
		loading="eager"
		fetchpriority="high"
		decoding="async"
	/>
	<div class="page-hero-shade"></div>
	<div class="container page-hero-inner">
		{crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h1>
			{
				title.split('\n').map((line, index) => (
					<>
						{index > 0 && <br />}
						{line}
					</>
				))
			}
		</h1>
		{lead && <p class="page-lead">{lead}</p>}
		<slot />
	</div>
</header>
