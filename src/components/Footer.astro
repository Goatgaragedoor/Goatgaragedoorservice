---
import { Image } from 'astro:assets';
import { services } from '../data/services';
import { site } from '../data/site';
import logo from '../assets/images/logo-mark.png';

const footerServices = [
	'garage-door-repair',
	'garage-door-spring-replacement',
	'garage-door-opener-installation',
	'garage-door-installation',
	'garage-door-cable-replacement',
	'garage-door-maintenance',
]
	.map((slug) => services.find((service) => service.slug === slug))
	.filter((service) => service !== undefined);
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<a class="footer-logo" href="/" aria-label={site.name}>
				<Image src={logo} alt="" width={168} height={184} densities={[1, 2]} quality={90} />
			</a>
			<p>
				Residential garage door repair and installation for Fishers, Indianapolis, and the surrounding area.
			</p>
		</div>
		<div>
			<h2>Quick Links</h2>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/about">About</a></li>
				<li><a href="/services">Services</a></li>
				<li><a href="/service-areas">Service Areas</a></li>
				<li><a href="/our-work">Our Work</a></li>
				<li><a href="/contact">Contact</a></li>
			</ul>
		</div>
		<div>
			<h2>Our Services</h2>
			<ul>
				{
					footerServices.map((service) => (
						<li>
							<a href={`/services/${service.slug}`}>{service.title.replace('Garage Door ', '')}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h2>Contact Us</h2>
			<ul class="footer-contact">
				<li>
					<a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
				</li>
				<li>
					<a href={`mailto:${site.email}`}>{site.email}</a>
				</li>
				<li>
					{site.address.street}<br />
					{site.address.city}, {site.address.region} {site.address.postalCode}
				</li>
			</ul>
			<div class="footer-social">
				<p>Find us on social media</p>
				<a href={site.facebook} target="_blank" rel="noopener noreferrer" aria-label="Goat Garage Door Service on Facebook">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M14.2 20.5v-6.6h2.3l.4-2.6h-2.7V9.6c0-.8.2-1.3 1.4-1.3h1.5V5.8c-.2 0-1.1-.1-2.1-.1-2.1 0-3.6 1.3-3.6 3.6v1.9H9.2v2.6h2.2v6.7h2.8z"></path>
					</svg>
				</a>
			</div>
		</div>
	</div>
	<div class="container footer-base">
		<p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
		<p class="footer-legal">
			<a href="/privacy">Privacy Policy</a>
			<a href="/terms">Terms & Conditions</a>
		</p>
	</div>
</footer>
<a class="float-call" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
