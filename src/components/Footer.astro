---
import { Image } from 'astro:assets';
import { services } from '../data/services';
import { site } from '../data/site';
import logo from '../assets/images/logo-mark.png';

const footerServices = [
	'off-track-garage-door-repair',
	'garage-door-spring-replacement',
	'garage-door-opener-installation',
	'garage-door-installation',
	'garage-door-cable-replacement',
	'garage-door-maintenance',
]
	.map((slug) => services.find((service) => service.slug === slug))
	.filter((service) => service !== undefined);
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<a class="footer-logo" href="/" aria-label={site.name}>
				<Image src={logo} alt="Goat Garage Door Service logo" title="Goat Garage Door Service" width={168} height={184} densities={[1, 2]} quality={90} />
			</a>
			<p>
				Residential garage door repair and installation for Fishers, Indianapolis, and the surrounding area.
			</p>
		</div>
		<div class="footer-col footer-links">
			<div class="ui-heading">Quick Links</div>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/about">About</a></li>
				<li><a href="/services">Services</a></li>
				<li><a href="/service-areas">Service Areas</a></li>
				<li><a href="/our-work">Our Work</a></li>
				<li><a href="/contact">Contact</a></li>
			</ul>
		</div>
		<div class="footer-col footer-services">
			<div class="ui-heading">Our Services</div>
			<ul>
				{
					footerServices.map((service) => (
						<li>
							<a href={`/services/${service.slug}`}>{service.title}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<div class="ui-heading">Contact Us</div>
			<ul class="footer-contact">
				<li>
					<a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
				</li>
				<li>
					<a href={`mailto:${site.email}`}>{site.email}</a>
				</li>
				<li>
					<a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
						{site.address.street}<br />
						{site.address.city}, {site.address.region} {site.address.postalCode}
					</a>
				</li>
				<li>Open {site.hours}</li>
			</ul>
			<div class="footer-social">
				<p>Find us on social media</p>
				<a href={site.facebook} target="_blank" rel="noopener noreferrer" aria-label="Goat Garage Door Service on Facebook">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M14.2 20.5v-6.6h2.3l.4-2.6h-2.7V9.6c0-.8.2-1.3 1.4-1.3h1.5V5.8c-.2 0-1.1-.1-2.1-.1-2.1 0-3.6 1.3-3.6 3.6v1.9H9.2v2.6h2.2v6.7h2.8z"></path>
					</svg>
				</a>
				<a href={site.bbb} target="_blank" rel="noopener noreferrer" aria-label="Goat Garage Door Service on the Better Business Bureau">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M13.4 1.9c.3 2.1-.6 3.3-1.6 4.4-1 1.2-2.2 2.3-2.2 4.3 0 1.3.8 2.5 2 3-.3-.7-.3-1.6.2-2.3.5-.8 1.3-1.3 1.3-2.5.9.8 1.5 2 1.5 3.2 0 .6-.2 1.2-.5 1.7 1.1-.5 1.9-1.7 1.9-3 0-2.9-2.6-4.1-2.6-6.6 1 .5 1.9 1.3 2.4 2.3.3-2.9-1.3-5.7-2.4-6.8-.6-.6-1.4-1-2.4-1.3.6.6 1.1 1.3 1.2 2.1-.2-.1-.4-.2-.6-.2z"></path>
						<path d="M8.5 16.4h7v1.6h-7zM9.5 19h5v1.5h-5z"></path>
					</svg>
				</a>
			</div>
		</div>
	</div>
	<div class="container footer-base">
		<p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
		<p class="footer-legal">
			<a href="/privacy">Privacy Policy</a>
			<a href="/terms">Terms & Conditions</a>
		</p>
	</div>
</footer>
<a class="float-call" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
