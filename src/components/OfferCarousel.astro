---
import { Image } from 'astro:assets';
import { services } from '../data/services';
import { site } from '../data/site';
import { workById } from '../data/work';

interface Props {
	kicker?: string;
	title?: string;
	titleId?: string;
	moreHref?: string;
	moreLabel?: string;
	quoteHref?: string;
	showMore?: boolean;
}

const {
	kicker = 'What we do',
	title = 'Our Services',
	titleId = 'offer-title',
	moreHref = '/services',
	moreLabel = 'View all services',
	quoteHref = '#quote',
	showMore = true,
} = Astro.props;

const offerIcons = {
	repair: `<svg class="offer-icon" viewBox="0 0 32 32" aria-hidden="true" fill="currentColor"><path d="M14.2 1.5h3.6l.7 8.4 6.6-5.4 2.5 2.5-5.4 6.6 8.3.7v3.6l-8.4.7 5.4 6.6-2.5 2.5-6.6-5.4-.7 8.4h-3.6l-.7-8.4-6.6 5.4-2.5-2.5 5.4-6.6-8.3-.7v-3.6l8.4-.7L5.1 7l2.5-2.5 6.6 5.4z"/></svg>`,
	spring: `<svg class="offer-icon" viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7"><ellipse cx="16" cy="6" rx="6.5" ry="3"/><ellipse cx="16" cy="12" rx="6.5" ry="3"/><ellipse cx="16" cy="18" rx="6.5" ry="3"/><ellipse cx="16" cy="24" rx="6.5" ry="3"/></svg>`,
	home: `<svg class="offer-icon" viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M5 15.2 16 6l11 9.2"/><path d="M8.5 13.8V26h15V13.8"/><path d="M13.5 26v-7h5v7"/></svg>`,
	seal: `<svg class="offer-icon" viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 16h22"/><path d="M8 11.5h16M8 20.5h16"/></svg>`,
	cable: `<svg class="offer-icon" viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M11 5v9c0 3.2 10 3.2 10 6.4V27"/><path d="M17 5v22"/></svg>`,
	panel: `<svg class="offer-icon" viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="6" y="6" width="8.5" height="8.5"/><rect x="17.5" y="6" width="8.5" height="8.5"/><rect x="6" y="17.5" width="8.5" height="8.5"/><rect x="17.5" y="17.5" width="8.5" height="8.5"/></svg>`,
	opener: `<svg class="offer-icon" viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="7" y="7" width="18" height="11" rx="1.2"/><path d="M12 18v7M20 18v7M12 25h8"/></svg>`,
};

const offerIconBySlug: Record<string, string> = {
	'emergency-garage-door-repair': offerIcons.repair,
	'garage-door-bottom-seal-replacement': offerIcons.seal,
	'garage-door-cable-replacement': offerIcons.cable,
	'garage-door-installation': offerIcons.home,
	'garage-door-maintenance': offerIcons.repair,
	'garage-door-opener-installation': offerIcons.home,
	'garage-door-opener-repair': offerIcons.opener,
	'garage-door-panel-replacement': offerIcons.panel,
	'garage-door-repair': offerIcons.repair,
	'garage-door-spring-replacement': offerIcons.spring,
};

const offer = services.map((service) => ({
	slug: service.slug,
	title: service.title.replace('Garage Door ', ''),
	text: service.card,
	icon: offerIconBySlug[service.slug] ?? offerIcons.repair,
	image: workById(service.imageId),
}));
---

<section class="offer" data-offer-band aria-labelledby={titleId}>
	<div class="container">
		<div class="band-head">
			<p class="band-kicker">{kicker}</p>
			<h2 id={titleId}>{title}</h2>
			<div class="offer-head-actions">
				{showMore && <a class="band-more" href={moreHref}>{moreLabel}</a>}
				<div class="hero-actions">
					<a class="btn btn-orange" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
					<a class="btn btn-ghost" href={quoteHref}>Request a free quote</a>
				</div>
			</div>
		</div>
		<div class="offer-stage">
			<button class="offer-prev" type="button" aria-label="Previous services">
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4">
					<path d="M15 5l-7 7 7 7"></path>
				</svg>
			</button>
			<div class="offer-viewport" data-offer-viewport aria-roledescription="carousel" aria-label="Services">
				<div class="offer-track" data-offer-track>
					{
						offer.map((item) => (
							<a class="offer-card" href={`/services/${item.slug}`}>
								<span class="offer-media">
									<Image
										src={item.image.src}
										alt=""
										widths={[480, 800]}
										sizes="(min-width: 900px) 360px, (min-width: 640px) 50vw, 100vw"
										quality={86}
									/>
								</span>
								<span class="offer-copy">
									<Fragment set:html={item.icon} />
									<strong>{item.title}</strong>
									<span>{item.text}</span>
									<span class="offer-more">Learn more</span>
								</span>
							</a>
						))
					}
				</div>
			</div>
			<button class="offer-next" type="button" aria-label="Next services">
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4">
					<path d="M9 5l7 7-7 7"></path>
				</svg>
			</button>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll('[data-offer-band]').forEach((band) => {
		const offerViewport = band.querySelector('[data-offer-viewport]');
		const offerTrack = band.querySelector('[data-offer-track]');
		const offerNext = band.querySelector('.offer-next');
		const offerPrev = band.querySelector('.offer-prev');
		const offerStage = offerViewport?.parentElement;

		if (!(offerViewport instanceof HTMLElement) || !(offerTrack instanceof HTMLElement) || !(offerNext instanceof HTMLButtonElement) || !(offerPrev instanceof HTMLButtonElement) || !(offerStage instanceof HTMLElement)) return;
		if (offerTrack.children.length < 2) return;

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const ease = 'transform 0.7s cubic-bezier(.22, .7, .28, 1)';
		let moving = false;
		let moveToken = 0;
		let direction = 1;
		let timer = 0;
		let pointerId: number | null = null;
		let originX = 0;
		let deltaX = 0;

		const distance = () => {
			const card = offerTrack.firstElementChild;
			if (!card) return 0;
			const gap = parseFloat(getComputedStyle(offerTrack).columnGap || getComputedStyle(offerTrack).gap) || 0;
			return card.getBoundingClientRect().width + gap;
		};

		const settle = (token: number) => {
			if (!moving || token !== moveToken) return;
			if (direction === 1) {
				const first = offerTrack.firstElementChild;
				if (first) offerTrack.appendChild(first);
			}
			offerTrack.style.transition = 'none';
			offerTrack.style.transform = 'translate3d(0, 0, 0)';
			void offerTrack.offsetWidth;
			moving = false;
		};

		const goNext = () => {
			const shift = distance();
			if (!shift || moving) return;
			direction = 1;
			if (reduceMotion) {
				const first = offerTrack.firstElementChild;
				if (first) offerTrack.appendChild(first);
				return;
			}
			moving = true;
			const token = ++moveToken;
			window.setTimeout(() => settle(token), 800);
			offerTrack.style.transition = ease;
			offerTrack.style.transform = `translate3d(${-shift}px, 0, 0)`;
		};

		const goPrev = () => {
			const shift = distance();
			const last = offerTrack.lastElementChild;
			if (!shift || !last || moving) return;
			direction = -1;
			if (reduceMotion) {
				offerTrack.prepend(last);
				return;
			}
			moving = true;
			const token = ++moveToken;
			offerTrack.style.transition = 'none';
			offerTrack.prepend(last);
			offerTrack.style.transform = `translate3d(${-shift}px, 0, 0)`;
			void offerTrack.offsetWidth;
			window.setTimeout(() => settle(token), 800);
			offerTrack.style.transition = ease;
			offerTrack.style.transform = 'translate3d(0, 0, 0)';
		};

		offerTrack.addEventListener('transitionend', (event) => {
			if (event.target !== offerTrack || event.propertyName !== 'transform') return;
			settle(moveToken);
		});

		const stop = () => window.clearInterval(timer);
		const start = () => {
			if (reduceMotion) return;
			stop();
			timer = window.setInterval(goNext, 4800);
		};

		offerNext.addEventListener('click', () => {
			goNext();
			start();
		});
		offerPrev.addEventListener('click', () => {
			goPrev();
			start();
		});

		offerStage.addEventListener('mouseenter', stop);
		offerStage.addEventListener('mouseleave', start);
		offerStage.addEventListener('focusin', stop);
		offerStage.addEventListener('focusout', (event) => {
			if (!offerStage.contains(event.relatedTarget as Node | null)) start();
		});
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stop();
			else start();
		});
		window.addEventListener('resize', () => {
			moveToken += 1;
			offerTrack.style.transition = 'none';
			offerTrack.style.transform = 'translate3d(0, 0, 0)';
			moving = false;
		});

		offerViewport.addEventListener('pointerdown', (event) => {
			if (event.button !== 0) return;
			pointerId = event.pointerId;
			originX = event.clientX;
			deltaX = 0;
		});
		offerViewport.addEventListener('pointermove', (event) => {
			if (event.pointerId !== pointerId) return;
			deltaX = event.clientX - originX;
		});
		const endPointer = (event: PointerEvent) => {
			if (event.pointerId !== pointerId) return;
			pointerId = null;
			if (deltaX < -48) {
				goNext();
				start();
			} else if (deltaX > 48) {
				goPrev();
				start();
			}
			deltaX = 0;
		};
		offerViewport.addEventListener('pointerup', endPointer);
		offerViewport.addEventListener('pointercancel', endPointer);

		start();
	});
</script>
