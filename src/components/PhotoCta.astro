---
import { site } from '../data/site';
import designInstall from '../assets/images/design/design-install.jpg';
---

<section class="photo-cta" aria-labelledby="photo-cta-title">
	<img
		class="photo-cta-media"
		src={designInstall.src}
		width={designInstall.width}
		height={designInstall.height}
		alt="Carriage-house garage door lit at dusk"
		loading="lazy"
		decoding="async"
	/>
	<div class="photo-cta-copy">
		<p class="band-kicker">On call today</p>
		<h2 id="photo-cta-title">Need the door working?</h2>
		<p>Call any hour, or send a note. The price comes before the work starts.</p>
		<div class="hero-actions">
			<a class="btn btn-orange" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
			<a class="btn btn-navy" href="/contact">Send a message</a>
		</div>
	</div>
</section>
