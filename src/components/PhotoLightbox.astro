<dialog class="photo-dialog" aria-label="Photo">
	<button type="button" class="photo-dialog-close" aria-label="Close photo">
		<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
			<path d="M6 6l12 12M18 6 6 18"></path>
		</svg>
	</button>
	<button type="button" class="photo-dialog-nav photo-dialog-prev" aria-label="Previous photo">
		<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
			<path d="M14.5 6 8.5 12l6 6"></path>
		</svg>
	</button>
	<div class="photo-dialog-frame">
		<img alt="" />
	</div>
	<button type="button" class="photo-dialog-nav photo-dialog-next" aria-label="Next photo">
		<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
			<path d="m9.5 6 6 6-6 6"></path>
		</svg>
	</button>
	<p class="photo-dialog-meta">
		<span class="photo-dialog-caption"></span>
		<span class="photo-dialog-count"></span>
	</p>
</dialog>

<script>
	const dialog = document.querySelector('.photo-dialog');
	const frame = dialog?.querySelector('.photo-dialog-frame');
	const dialogImage = dialog?.querySelector('img');
	const closeButton = dialog?.querySelector('.photo-dialog-close');
	const prevButton = dialog?.querySelector('.photo-dialog-prev');
	const nextButton = dialog?.querySelector('.photo-dialog-next');
	const caption = dialog?.querySelector('.photo-dialog-caption');
	const count = dialog?.querySelector('.photo-dialog-count');

	type Shot = { full: string; alt: string; caption: string };

	if (
		dialog instanceof HTMLDialogElement &&
		frame instanceof HTMLElement &&
		dialogImage instanceof HTMLImageElement &&
		closeButton instanceof HTMLButtonElement &&
		prevButton instanceof HTMLButtonElement &&
		nextButton instanceof HTMLButtonElement &&
		caption instanceof HTMLElement &&
		count instanceof HTMLElement
	) {
		let shots: Shot[] = [];
		let index = 0;
		let pointerId: number | null = null;
		let originX = 0;

		const shown = (element: Element) => {
			const host = element.closest('figure') ?? element;
			return getComputedStyle(host).display !== 'none' && host.getClientRects().length > 0;
		};

		const fromButton = (button: HTMLButtonElement): Shot => {
			const photo = button.querySelector('img');
			return {
				full: button.getAttribute('data-full') || photo?.currentSrc || photo?.src || '',
				alt: photo?.alt || button.getAttribute('data-alt') || '',
				caption: button.getAttribute('data-caption') || '',
			};
		};

		const fromItem = (item: HTMLElement): Shot => ({
			full: item.getAttribute('data-full') || '',
			alt: item.getAttribute('data-alt') || '',
			caption: item.getAttribute('data-caption') || '',
		});

		const collect = (gallery: string, opener: HTMLButtonElement) => {
			const buttons = [...document.querySelectorAll<HTMLButtonElement>(`[data-photo][data-gallery="${CSS.escape(gallery)}"]`)].filter(shown);
			const startAt = opener.getAttribute('data-index');
			if (startAt !== null) {
				const items = [...document.querySelectorAll<HTMLElement>(`[data-gallery-item][data-gallery="${CSS.escape(gallery)}"]`)];
				if (items.length > 1) {
					return { shots: items.map(fromItem).filter((shot) => shot.full), index: Number(startAt) || 0 };
				}
			}
			const list = (buttons.length ? buttons : [opener]).map(fromButton).filter((shot) => shot.full);
			const found = buttons.indexOf(opener);
			return { shots: list, index: found >= 0 ? found : 0 };
		};

		const render = () => {
			const shot = shots[index];
			if (!shot) return;
			const single = shots.length < 2;
			prevButton.hidden = single;
			nextButton.hidden = single;
			dialogImage.src = shot.full;
			dialogImage.alt = shot.alt;
			caption.textContent = shot.caption;
			count.textContent = single ? '' : `${index + 1} / ${shots.length}`;
			dialog.setAttribute('aria-label', shot.caption || shot.alt || 'Photo');
		};

		const step = (delta: number) => {
			if (shots.length < 2) return;
			index = (index + delta + shots.length) % shots.length;
			render();
		};

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const opener = target.closest<HTMLButtonElement>('[data-photo]');
			if (!opener) return;
			const gallery = opener.getAttribute('data-gallery');
			if (!gallery) return;
			const next = collect(gallery, opener);
			if (!next.shots.length) return;
			shots = next.shots;
			index = Math.min(Math.max(next.index, 0), shots.length - 1);
			render();
			if (!dialog.open) dialog.showModal();
		});

		prevButton.addEventListener('click', () => step(-1));
		nextButton.addEventListener('click', () => step(1));
		closeButton.addEventListener('click', () => dialog.close());

		dialog.addEventListener('click', (event) => {
			if (event.target === dialog || event.target === frame) dialog.close();
		});

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				step(-1);
			} else if (event.key === 'ArrowRight') {
				event.preventDefault();
				step(1);
			}
		});

		frame.addEventListener('pointerdown', (event) => {
			if (event.button !== 0) return;
			pointerId = event.pointerId;
			originX = event.clientX;
		});
		frame.addEventListener('pointerup', (event) => {
			if (event.pointerId !== pointerId) return;
			pointerId = null;
			const delta = event.clientX - originX;
			if (delta > 48) step(-1);
			else if (delta < -48) step(1);
		});
		frame.addEventListener('pointercancel', () => {
			pointerId = null;
		});

		dialog.addEventListener('close', () => {
			dialogImage.removeAttribute('src');
			dialogImage.alt = '';
			caption.textContent = '';
			count.textContent = '';
			dialog.setAttribute('aria-label', 'Photo');
		});
	}
</script>
