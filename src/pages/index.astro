---
import BaseLayout from '../layouts/BaseLayout.astro';
import OfferCarousel from '../components/OfferCarousel.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { areas } from '../data/areas';
import { googleRanking } from '../data/reviews';
import { faqNode, pageSchema } from '../data/schema';
import { site } from '../data/site';
import designHero from '../assets/images/design/hero-truck.jpg';
import designHero2 from '../assets/images/design/hero-tech.jpg';
import designHero3 from '../assets/images/design/hero-opener.jpg';
import designInstall from '../assets/images/design/design-install.jpg';
import designClosing from '../assets/images/design/design-closing.jpg';
import formOpener from '../assets/images/design/form-opener.jpg';
import goatHead from '../assets/images/goat-head.png';

const reasons = [
	{
		title: 'On call day and night',
		text: 'A stuck door does not wait until morning. The phone is answered 24/7, including holidays.',
	},
	{
		title: 'The price comes first',
		text: 'You hear the number before any repair starts. No surprise once the door is apart.',
	},
	{
		title: 'A Fishers crew',
		text: 'We are based on Glenn Abbey Lane. The person who answers is the one who rolls the truck.',
	},
	{
		title: 'The whole door, not one part',
		text: 'Springs, cables, and balance get checked by hand before the opener is hooked back up.',
	},
];

const heroSources = [
	{ src: designHero, alt: 'Red Goat Garage Door Service truck parked in a driveway at dusk' },
	{ src: designHero2, alt: 'Technician on a ladder working at the top of a white garage door' },
	{ src: designHero3, alt: 'LiftMaster garage door opener and torsion springs above a white door' },
	{ src: designInstall, alt: 'Black carriage-house garage door on a stone and siding home at night' },
	{ src: designClosing, alt: 'White carriage-house garage door with black handles on a gray house' },
	{ src: formOpener, alt: 'Technician installing a LiftMaster garage door opener' },
];


const featuredAreaSlugs = [
	'fishers',
	'indianapolis',
	'carmel',
	'noblesville',
	'westfield',
	'lawrence',
	'zionsville',
	'greenwood',
	'brownsburg',
];

const featuredAreas = featuredAreaSlugs.map((slug) => {
	const area = areas.find((item) => item.slug === slug);
	if (!area) throw new Error(slug);
	return area;
});

const faqs = [
	{
		q: 'Do you answer at night?',
		a: 'Yes. Hours are 24/7, including weekends and holidays. Call 317-854-6917 if the door is stuck open, hanging crooked, or will not lift.',
	},
	{
		q: 'Do you quote before the repair starts?',
		a: 'Yes. You hear the number before any repair starts. If a full door is the right fix instead of one part, we say that before the door comes apart.',
	},
	{
		q: 'What should I do if a spring snaps?',
		a: 'Leave the door alone. Springs and cables are under tension. Keep people and cars clear, and do not pull the red release to lift a two-car door by hand.',
	},
	{
		q: 'Can you fix it the same visit?',
		a: 'Springs, cables, rollers, hinges, seals, and openers are the usual same-visit repairs. We bring the parts those symptoms usually need, then test the door and the auto-reverse before we leave.',
	},
	{
		q: 'Which towns do you cover?',
		a: 'Home base is 10378 Glenn Abbey Ln in Fishers. We also cover Indianapolis, Carmel, Noblesville, Westfield, Lawrence, McCordsville, Zionsville, Greenwood, Anderson, Brownsburg, and Greenfield.',
	},
	{
		q: 'Do you install new doors, or only repair?',
		a: 'Both. We repair the door you have and install new insulated and carriage-house doors, plus openers, when a replacement is the right job.',
	},
];
---

<BaseLayout
	title="Garage Door Repair & Installation | Goat Garage Door Service"
	description="Reliable garage door repair and installation in Fishers and Indianapolis. Springs, openers, cables, and new doors. Call 317-854-6917, open 24/7."
	schema={pageSchema([faqNode(faqs)])}
>
	<div class="home">
	<div class="screen-hero">
	<section class="hero" id="quote">
		<div class="hero-media">
			<div class="hero-track">
				{
					heroSources.map((slide, index) => (
						<div class="hero-slide">
							<img
								src={slide.src.src}
								width={slide.src.width}
								height={slide.src.height}
								alt=""
								loading="eager"
								decoding="async"
								fetchpriority={index === 0 ? 'high' : 'low'}
							/>
						</div>
					))
				}
			</div>
			<div class="hero-shade"></div>
		</div>
		<div class="hero-controls">
			<div class="hero-dots">
				{
					heroSources.map((slide, index) => (
						<button type="button" aria-label={`Show photo ${index + 1} of ${heroSources.length}`} aria-current={index === 0 ? 'true' : undefined}></button>
					))
				}
			</div>
		</div>
		<div class="container hero-inner">
			<div class="hero-copy">
				<p class="eyebrow">Garage door repair &amp; installation</p>
				<h1>Reliable Garage<br />Door Service <span>When You Need It</span></h1>
				<p>
					From urgent repairs to brand new installations, our local team keeps your home safe, secure, and looking its best.
				</p>
				<div class="hero-actions">
					<a class="btn btn-orange" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
				</div>
				<ul class="hero-points">
					<li>
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
							<path d="M6 4h4l2 5-3 2a12 12 0 0 0 6 6l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 4 6a2 2 0 0 1 2-2z"></path>
						</svg>
						24/7 Emergency Service
					</li>
					<li>
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
							<path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"></path>
						</svg>
						Trusted Local Technicians
					</li>
					<li>
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
							<path d="m12 3.2 2.2 4.6 5.1.6-3.8 3.4 1 5.1L12 14.6 7.5 17l1-5.1L4.7 8.4l5.1-.6z"></path>
						</svg>
						5-Star Service Across Indy Metro
					</li>
				</ul>
			</div>
			<QuoteForm variant="hero" />
		</div>
	</section>

	<section class="stats">
		<ul class="container">
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
					<circle cx="12" cy="12" r="9"></circle>
					<path d="M12 7v5l3 2"></path>
				</svg>
				<strong>24/7</strong>
				<span>Emergency Service</span>
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="M14.7 6.3a4 4 0 0 0-5.6 5.6L4 17l3 3 5.1-5.1a4 4 0 0 0 5.6-5.6l-2.2 2.2-2.8-2.8z"></path>
				</svg>
				<strong>500+</strong>
				<span>Doors Repaired</span>
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="M4 11.5 12 5l8 6.5"></path>
					<path d="M7 10.5V19h10v-8.5"></path>
				</svg>
				<strong>100%</strong>
				<span>Local &amp; Family Operated</span>
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
					<path d="m12 3.2 2.4 5.1 5.6.7-4.1 3.8 1.1 5.5L12 15.8 7 18.3l1.1-5.5L4 9l5.6-.7z"></path>
				</svg>
				<strong>5-Star</strong>
				<span>Customer Reviews</span>
			</li>
		</ul>
	</section>
	</div>

	<OfferCarousel quoteHref="#quote" />

	<section class="reasons" aria-labelledby="reasons-title">
		<img
			class="reasons-mark"
			src={goatHead.src}
			width={goatHead.width}
			height={goatHead.height}
			alt=""
		/>
		<div class="container reasons-layout">
			<div class="reasons-statement">
				<p class="band-kicker">Why choose us</p>
				<h2 id="reasons-title">
					The price<br />
					is said<br />
					<span>out loud.</span>
				</h2>
				<p>
					A Fishers crew answers day and night, names the number before the door comes apart, and checks the whole job before they leave.
				</p>
				<a class="band-more" href="/about">About us</a>
				<a
					class="bbb-seal"
					href="https://www.bbb.org/us/in/fishers/profile/garage-doors/goat-garage-door-service-0382-90073899/#sealclick"
					target="_blank"
					rel="nofollow noopener noreferrer"
				>
					<img
						src="https://seal-indy.bbb.org/seals/blue-seal-160-82-bbb-90073899.png"
						width="160"
						height="82"
						alt="Goat Garage Door Service BBB Business Review"
					/>
				</a>
			</div>
			<ol class="reason-list">
				{
					reasons.map((item, index) => (
						<li>
							<span class="reason-index" aria-hidden="true">
								{String(index + 1).padStart(2, '0')}
							</span>
							<div>
								<strong>{item.title}</strong>
								<span>{item.text}</span>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="trusted" aria-labelledby="trusted-title">
		<div class="container trusted-layout">
			<div class="trusted-copy">
				<svg class="trusted-shadow" viewBox="0 0 78 46" aria-hidden="true" fill="currentColor">
					<path d="M17.2 46C7.6 46 1.2 39.2 1.2 28.8 1.2 16.2 7.4 6.4 19.6 1.2l4.2 6.4C15.2 11.2 11.4 16.6 10.6 23.2c1.4-.6 3-1 4.8-1 6.2 0 10.6 4.2 10.6 10.4C26 39 22.2 46 17.2 46zm36 0C43.6 46 37.2 39.2 37.2 28.8 37.2 16.2 43.4 6.4 55.6 1.2l4.2 6.4C51.2 11.2 47.4 16.6 46.6 23.2c1.4-.6 3-1 4.8-1 6.2 0 10.6 4.2 10.6 10.4C62 39 58.2 46 53.2 46z"></path>
				</svg>
				<div class="trusted-title">
					<p class="band-kicker">Testimonials</p>
					<h2 id="trusted-title">Trusted by our clients</h2>
				</div>
				<a class="band-more" href={site.mapsUrl}>
					<span class="rank-score">
						{googleRanking.score}
						<span class="rank-stars" aria-hidden="true">
							{
								Array.from({ length: 5 }, () => (
									<svg viewBox="4.5 3 15 14.2" fill="currentColor">
										<path d="m12 3.2 2.2 4.6 5.1.6-3.8 3.4 1 5.1L12 14.6 7.5 17l1-5.1L4.7 8.4l5.1-.6z"></path>
									</svg>
								))
							}
						</span>
					</span>
					<span>on Google</span>
				</a>
			</div>
			<div class="quote-stage">
				<div class="quote-viewport" data-quote-viewport aria-roledescription="carousel" aria-label="Five-star Google reviews">
					<div class="quote-track" data-quote-track></div>
				</div>
				<button class="quote-next" type="button" aria-label="Next reviews" hidden>
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4">
						<path d="M9 5l7 7-7 7"></path>
					</svg>
				</button>
			</div>
		</div>
	</section>

	<section class="places" aria-labelledby="places-title">
		<div class="container places-layout">
			<div class="places-copy">
				<p class="band-kicker">Service areas</p>
				<h2 id="places-title">Fishers and the<br />towns around it</h2>
				<p>
					We provide garage door repair, installation, and maintenance throughout Fishers, Indianapolis, and the surrounding communities.
				</p>
				<div class="places-actions">
					<a class="btn btn-orange places-all" href="/service-areas">
						View all areas
						<span aria-hidden="true">→</span>
					</a>
					<a class="btn btn-line places-call" href={`tel:${site.phoneTel}`}>Call now</a>
				</div>
			</div>
			<div class="place-grid">
				{
					featuredAreas.map((area) => (
						<a class="place-card" href={`/service-areas/${area.slug}`}>
							<span class="place-name">
								<strong>{area.name}</strong>
								<span>{area.county}</span>
							</span>
							<svg class="place-pin" viewBox="0 0 24 24" aria-hidden="true">
								<path
									fill="currentColor"
									fill-rule="evenodd"
									d="M12 2.15a6.85 6.85 0 0 0-6.85 6.95c0 5.15 6.85 12.75 6.85 12.75s6.85-7.6 6.85-12.75A6.85 6.85 0 0 0 12 2.15zm0 9.35a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"
								/>
							</svg>
						</a>
					))
				}
			</div>
		</div>
		<div class="container places-map">
			<iframe
				class="map-frame"
				title="Goat Garage Door Service on Google Maps"
				src={site.mapEmbed}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			></iframe>
			<p>
				<a href={site.mapsUrl} target="_blank" rel="noopener noreferrer">Open the listing in Google Maps</a>
			</p>
		</div>
	</section>

	<section class="built" aria-labelledby="built-title">
		<div class="container">
			<div class="band-head">
				<p class="band-kicker">Recent projects</p>
				<h2 id="built-title">Built to last</h2>
				<a class="band-more" href="/our-work">View all projects</a>
			</div>
			<ProjectCarousel gallery="home-projects" />
		</div>
	</section>

	<section class="home-faq" aria-labelledby="faq-title">
		<div class="container">
			<div class="band-head">
				<p class="band-kicker">Questions</p>
				<h2 id="faq-title">Before you call</h2>
			</div>
			<div class="faq">
				{
					faqs.map((faq) => (
						<details>
							<summary>{faq.q}</summary>
							<p>{faq.a}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	</div>
</BaseLayout>

<script>
	const hero = document.querySelector('.hero');
	const track = hero?.querySelector('.hero-track');
	const dots = [...(hero?.querySelectorAll('.hero-dots button') ?? [])];

	if (hero && track && dots.length) {
		let index = 0;
		let timer = 0;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const show = (next) => {
			index = (next + dots.length) % dots.length;
			track.style.transform = `translateX(${-index * 100}%)`;
			dots.forEach((dot, dotIndex) => {
				if (dotIndex === index) dot.setAttribute('aria-current', 'true');
				else dot.removeAttribute('aria-current');
			});
		};

		const stop = () => window.clearInterval(timer);
		const start = () => {
			if (reduce) return;
			stop();
			timer = window.setInterval(() => {
				show(index + 1);
			}, 5500);
		};

		dots.forEach((dot, dotIndex) => {
			dot.addEventListener('click', () => {
				show(dotIndex);
				start();
			});
		});

		hero.addEventListener('mouseenter', stop);
		hero.addEventListener('mouseleave', start);
		hero.addEventListener('focusin', stop);
		hero.addEventListener('focusout', (event) => {
			if (!hero.contains(event.relatedTarget)) start();
		});
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stop();
			else start();
		});
		start();
	}
</script>


<script>
	const quoteViewport = document.querySelector('[data-quote-viewport]');
	const quoteTrack = document.querySelector('[data-quote-track]');
	const quoteNext = document.querySelector('.quote-next');
	const quoteMark =
		'<svg class="quote-mark" viewBox="0 0 78 46" aria-hidden="true" fill="currentColor"><path d="M17.2 46C7.6 46 1.2 39.2 1.2 28.8 1.2 16.2 7.4 6.4 19.6 1.2l4.2 6.4C15.2 11.2 11.4 16.6 10.6 23.2c1.4-.6 3-1 4.8-1 6.2 0 10.6 4.2 10.6 10.4C26 39 22.2 46 17.2 46zm36 0C43.6 46 37.2 39.2 37.2 28.8 37.2 16.2 43.4 6.4 55.6 1.2l4.2 6.4C51.2 11.2 47.4 16.6 46.6 23.2c1.4-.6 3-1 4.8-1 6.2 0 10.6 4.2 10.6 10.4C62 39 58.2 46 53.2 46z"></path></svg>';

	const fillReviews = (reviews) => {
		quoteTrack.replaceChildren(
			...reviews.map((review) => {
				const card = document.createElement('blockquote');
				card.className = 'quote-card';
				card.innerHTML = `${quoteMark}<p></p><footer><strong></strong><span>5-star Google review</span></footer>`;
				card.querySelector('p').textContent = review.quote;
				card.querySelector('strong').textContent = review.name;
				return card;
			}),
		);
	};

	const loadReviews = async () => {
		const response = await fetch('/api/google-reviews');
		if (!response.ok) return [];
		const data = await response.json();
		return Array.isArray(data.reviews) ? data.reviews : [];
	};

	if (quoteViewport && quoteTrack && quoteNext) {
		const reviews = await loadReviews();
		fillReviews(reviews);
		if (reviews.length > 2) quoteNext.hidden = false;
	}

	if (quoteViewport && quoteTrack && quoteTrack.children.length > 2) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const ease = 'transform 0.7s cubic-bezier(.22, .7, .28, 1)';
		let moving = false;
		let moveToken = 0;
		let direction = 1;
		let timer = 0;
		let pointerId = null;
		let originX = 0;
		let deltaX = 0;

		const distance = () => {
			const card = quoteTrack.firstElementChild;
			if (!card) return 0;
			const gap = parseFloat(getComputedStyle(quoteTrack).columnGap || getComputedStyle(quoteTrack).gap) || 0;
			return card.getBoundingClientRect().width + gap;
		};

		const settle = (token) => {
			if (!moving || token !== moveToken) return;
			if (direction === 1) quoteTrack.appendChild(quoteTrack.firstElementChild);
			quoteTrack.style.transition = 'none';
			quoteTrack.style.transform = 'translate3d(0, 0, 0)';
			void quoteTrack.offsetWidth;
			moving = false;
		};

		const arm = () => {
			moving = true;
			const token = ++moveToken;
			window.setTimeout(() => settle(token), 800);
			return token;
		};

		const goNext = () => {
			const shift = distance();
			if (!shift || moving) return;
			direction = 1;
			if (reduceMotion) {
				quoteTrack.appendChild(quoteTrack.firstElementChild);
				return;
			}
			arm();
			quoteTrack.style.transition = ease;
			quoteTrack.style.transform = `translate3d(${-shift}px, 0, 0)`;
		};

		const goPrev = () => {
			const shift = distance();
			if (!shift || moving) return;
			direction = -1;
			quoteTrack.insertBefore(quoteTrack.lastElementChild, quoteTrack.firstElementChild);
			if (reduceMotion) return;
			arm();
			quoteTrack.style.transition = 'none';
			quoteTrack.style.transform = `translate3d(${-shift}px, 0, 0)`;
			void quoteTrack.offsetWidth;
			quoteTrack.style.transition = ease;
			quoteTrack.style.transform = 'translate3d(0, 0, 0)';
		};

		quoteTrack.addEventListener('transitionend', (event) => {
			if (event.target !== quoteTrack || event.propertyName !== 'transform') return;
			settle(moveToken);
		});

		const stop = () => window.clearInterval(timer);
		const start = () => {
			if (reduceMotion) return;
			stop();
			timer = window.setInterval(goNext, 5200);
		};

		quoteNext?.addEventListener('click', () => {
			goNext();
			start();
		});

		quoteViewport.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				goNext();
				start();
			} else if (event.key === 'ArrowLeft') {
				event.preventDefault();
				goPrev();
				start();
			}
		});

		quoteViewport.addEventListener('mouseenter', stop);
		quoteViewport.addEventListener('mouseleave', start);
		quoteViewport.addEventListener('focusin', stop);
		quoteViewport.addEventListener('focusout', (event) => {
			if (!quoteViewport.contains(event.relatedTarget)) start();
		});
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stop();
			else start();
		});
		window.addEventListener('resize', () => {
			moveToken += 1;
			quoteTrack.style.transition = 'none';
			quoteTrack.style.transform = 'translate3d(0, 0, 0)';
			moving = false;
		});

		quoteViewport.addEventListener('pointerdown', (event) => {
			if (event.button !== 0 || event.target.closest('.quote-next')) return;
			pointerId = event.pointerId;
			originX = event.clientX;
			deltaX = 0;
		});
		quoteViewport.addEventListener('pointermove', (event) => {
			if (event.pointerId !== pointerId) return;
			deltaX = event.clientX - originX;
			if (Math.abs(deltaX) > 48) quoteViewport.setPointerCapture(event.pointerId);
		});
		const endPointer = (event) => {
			if (event.pointerId !== pointerId) return;
			pointerId = null;
			if (Math.abs(deltaX) > 48) {
				if (deltaX < 0) goNext();
				else goPrev();
				start();
			}
			deltaX = 0;
		};
		quoteViewport.addEventListener('pointerup', endPointer);
		quoteViewport.addEventListener('pointercancel', endPointer);

		start();
	}
</script>
