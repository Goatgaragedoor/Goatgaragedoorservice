---
import '../styles/global.css';
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow-condensed/latin-800.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoCta from '../components/PhotoCta.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import { pageSchema } from '../data/schema';
import { routePath, site } from '../data/site';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	schema?: Record<string, unknown>;
	showPhotoCta?: boolean;
}

const { title, description, noindex = false, schema, showPhotoCta = true } = Astro.props;
const canonical = new URL(routePath(Astro.url.pathname), site.domain).href;
const jsonLd = JSON.stringify(schema ?? pageSchema()).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="theme-color" content="#14181c" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={`${site.domain}/og.jpg`} />
		<meta property="og:image:width" content="1024" />
		<meta property="og:image:height" content="576" />
		<meta property="og:image:alt" content="Goat Garage Door Service truck at a home at sunset" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${site.domain}/og.jpg`} />
		<script type="application/ld+json" set:html={jsonLd} />
	</head>
	<body>
		<Header />
		<main id="main">
			<slot />
			{showPhotoCta && <PhotoCta />}
		</main>
		<Footer />
		<PhotoLightbox />
	</body>
</html>
